// PROD job (Jenkins job "backqup-prod", branch main, started manually with VERSION).
// amd64 agent: unit tests and image build (no e2e: it would start test databases
// on the PROD host), then pushes REGISTRY/qursor/backqup:<VERSION> and :latest
// for the PROD servers (amd64 only). An already published VERSION is never overwritten.
// Credentials: 'qursor-registry' (username/password), 'discord-webhook-internal'.
pipeline {
    agent { label 'amd64 && docker' }

    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'Release version, e.g. 1.2.3 (published as qursor/backqup:1.2.3 and :latest)')
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY = 'registry.qursor.dev'
        IMAGE = "${REGISTRY}/qursor/backqup"
        DISCORD_WEBHOOK_URL = credentials('discord-webhook-internal')
        DOCKER_BUILDKIT = '1'
        BUILDKIT_PROGRESS = 'plain'
    }

    stages {
        stage('Validate version') {
            steps {
                script {
                    if (!(params.VERSION ==~ /\d+\.\d+\.\d+/)) {
                        error("VERSION must be X.Y.Z, got '${params.VERSION}'")
                    }
                }
            }
        }

        stage('Unit tests') {
            steps {
                sh 'docker build --target test .'
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build --build-arg VERSION="$VERSION" -t "backqup:ci-$BUILD_NUMBER" .'
            }
        }

        stage('Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'qursor-registry',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_PASS')]) {
                    sh '''
                        set -eu
                        echo "$REG_PASS" | docker login "$REGISTRY" -u "$REG_USER" --password-stdin
                        if docker manifest inspect "$IMAGE:$VERSION" >/dev/null 2>&1; then
                            echo "$IMAGE:$VERSION already exists: release versions are immutable, pick a new VERSION." >&2
                            exit 1
                        fi
                        docker tag "backqup:ci-$BUILD_NUMBER" "$IMAGE:$VERSION"
                        docker tag "backqup:ci-$BUILD_NUMBER" "$IMAGE:latest"
                        docker push "$IMAGE:$VERSION"
                        docker push "$IMAGE:latest"
                        docker rmi "$IMAGE:$VERSION" "$IMAGE:latest" >/dev/null 2>&1 || true
                    '''
                }
            }
        }
    }

    post {
        success {
            discordSend description: "backqup ${params.VERSION} published to the registry (prod, amd64).",
                    footer: "#${env.BUILD_NUMBER}", link: env.BUILD_URL, result: 'SUCCESS',
                    title: "[BACKQUP-PROD] Build SUCCEEDED", webhookURL: env.DISCORD_WEBHOOK_URL
        }
        failure {
            discordSend description: 'backqup prod build failed. Check the logs.',
                    footer: "#${env.BUILD_NUMBER}", link: env.BUILD_URL, result: 'FAILURE',
                    title: "[BACKQUP-PROD] Build FAILED", webhookURL: env.DISCORD_WEBHOOK_URL
        }
        always {
            sh 'docker rmi "backqup:ci-$BUILD_NUMBER" >/dev/null 2>&1 || true'
            sh 'docker logout "$REGISTRY" >/dev/null 2>&1 || true'
            cleanWs(notFailBuild: true)
        }
    }
}
